{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "mr-creams-backend",
  "version": "1.0.0",
  "description": "Backend API for MR.CREAMS - Modern Relationship Conflict Resolution & Emotion Analysis Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --passWithNoTests",
    "lint": "eslint \"**/*.js\" || true",
    "format": "prettier --write \"**/*.js\" || true",
    "knex": "knex --knexfile knexfile.js",
    "migrate": "npx knex migrate:latest --knexfile knexfile.js --disable-transactions || node scripts/runMigrations.js",
    "migrate:rollback": "npx knex migrate:rollback --knexfile knexfile.js --disable-transactions",
    "migrate:status": "npx knex migrate:status --knexfile knexfile.js",
    "migrate:make": "npx knex migrate:make",
    "migrate:legacy": "node scripts/runMigrations.js",
    "migrate:data": "node scripts/migrateSqliteToPostgres.js",
    "setup:db": "npm run migrate || true && npm run migrate:data || true",
    "seed:demo": "node scripts/seedCredentials.js"
  },
  "dependencies": {
    "@casl/ability": "^6.7.5",
    "@prisma/client": "^7.9.0",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.0",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.10",
    "morgan": "^1.11.0",
    "nodemailer": "^7.0.12",
    "pg": "^8.11.3",
    "prisma": "^7.9.0",
    "prom-client": "^15.1.3",
    "sqlite3": "^5.1.7",
    "stripe": "^14.0.0",
    "uuid": "^9.0.1",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.2.5"
  },
  "keywords": [
    "express",
    "api",
    "postgres",
    "relationship",
    "emotion",
    "analysis",
    "healing",
    "mr-creams"
  ],
  "author": "MR.CREAMS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CappieX/MRCREAMS-Api.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CappieX/MRCREAMS-Api/issues"
  },
  "homepage": "https://github.com/CappieX/MRCREAMS-Api#readme"
}
